# Скопируйте этот файл в .env и заполните значения.
#   cp .env.example .env
# .env не коммитится (см. .gitignore) — ключ в репозиторий не попадает.

# --- Обязательное для работы Gemini -----------------------------------------
# Ключ из Google AI Studio: https://aistudio.google.com/apikey
# Если ключ не задан, чат продолжит работать на мок-ответах (src/mock/mockChat.js).
GEMINI_API_KEY=

# --- Необязательные настройки ------------------------------------------------
# Модель Gemini. Актуальные имена: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.6-flash

# Транспорт Gemini API: auto | generate-content | interactions
#   auto             — сначала generateContent, при неудаче — interactions (по умолчанию)
#   generate-content — только POST /v1beta/models/{model}:generateContent (проверено рабочим)
#   interactions     — только POST /v1beta/interactions (может требовать отдельной квоты)
GEMINI_TRANSPORT=auto

# Уровень «раздумий» модели: minimal | low | medium | high.
# Пусто — параметр не передаётся. Для чата поддержки хватает low.
GEMINI_THINKING_LEVEL=

# Базовый адрес API (меняется для прокси/эмулятора).
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# Порт локального сервера.
PORT=5173

# Максимальное время ожидания ответа Gemini, мс.
GEMINI_TIMEOUT_MS=25000
